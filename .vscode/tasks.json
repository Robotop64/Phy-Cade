        {
            "label": "Launch",
            "type": "shell",
            "command": "powershell",
            "args": [
                "${workspaceFolder}/out/bin/PacPhi.exe"
            ],
            "options": {
                "cwd": "${workspaceFolder}/out/"
            }
        },
        {
            "label": "Clean Out",
            "type": "shell",
            "command": "powershell",
            "args": [
                "Remove-Item -Path ${workspaceFolder}/out/* -Recurse -Force"
            ]
        },
        {
            "label": "Clean Build",
            "type": "shell",
            "command": "powershell",
            "args": [
                "Remove-Item -Path ${workspaceFolder}/build/* -Recurse -Force"
            ]
        }
    ]
}